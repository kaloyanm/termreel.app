# scenario.example.yaml
#
# Describes one "episode": which Docker image/repo to use, and the sequence
# of terminal actions to type out and record.

title: "Fix a race condition in a Go worker pool"

docker:
  flavour: "rust"
  container_name: "ytdemo_race_condition"
  # Host directory mounted into the container at /repo.
  # Populate this with whatever source code the episode needs.
  mount_host_path: "./demo-repo"
  mount_container_path: "/repo"
  workdir: "/repo"

typing:
  # Characters per second, with jitter, to simulate a human typing.
  base_cps: 14
  jitter_pct: 0.35
  # Pause (seconds) after pressing Enter on a command, before continuing.
  default_pause_after: 1.5

steps:
  - type: command
    text: "cat worker.go"
    pause_after: 3

  - type: comment
    # Rendered as a typed shell comment, e.g. `# Notice the shared counter...`
    text: "Notice the shared counter isn't protected by a mutex"
    pause_after: 2.5

  - type: command
    text: "go run worker.go"
    pause_after: 3

  - type: comment
    text: "Let's add a mutex around the increment"
    pause_after: 2

  - type: write_file
    # Writes a file into the container using a heredoc, typed out on screen.
    path: "worker.go"
    content_file: "./demo-repo/worker_fixed.go"
    pause_after: 2

  # There is also a `write_vim` step type: instead of a heredoc, it opens
  # `vim` in the recorded terminal and types the target content into it
  # (character by character in blank mode, or as a live diff-driven edit
  # against whatever's already at `path` in the container) - see
  # requirements/src/functional-requirements/cli-pipeline.md (FR-CLI-009..
  # 011) for the full behavior. Requires `vim` to be installed in the
  # scenario's Docker image. Example (not used by this scenario):
  #
  # - type: write_vim
  #   path: "worker.go"
  #   content_file: "./demo-repo/worker_fixed.go"
  #   simulate_typos: false   # optional: simulate occasional typo+backspace
  #   force_blank: false      # optional: always wipe+retype instead of
  #                            # diff-editing an existing file at `path`

  # There is also a `presenterm` step type: it silently writes Markdown
  # content into the container (never typed on screen, unlike write_file's
  # heredoc - the point is to show the rendered slideshow, not the markdown
  # source), then opens `presenterm` in the recorded terminal and drives
  # slide advances automatically. Slide count is auto-detected from
  # `<!-- end_slide -->` markers in the content, plus one extra slide if the
  # content opens with a `---`...`---` YAML front matter block (which
  # presenterm renders as an introduction slide) - see
  # requirements/src/functional-requirements/cli-pipeline.md (FR-CLI-013)
  # for the full behavior. Requires `presenterm` to be installed in the
  # scenario's Docker image (already true for the `rust` flavour). Known
  # limitation: `<!-- pause -->` incremental reveals are not supported in
  # v1. Example (not used by this scenario):
  #
  # - type: presenterm
  #   path: "talk.md"
  #   content_file: "./demo-repo/talk.md"
  #   slide_pause: 2.5   # optional: seconds before each slide advance
  #                      # (default: driver.py's PRESENTERM_DEFAULT_SLIDE_PAUSE, 2.0s)

  - type: command
    text: "go run worker.go"
    pause_after: 3

  - type: command
    text: "go vet ./..."
    pause_after: 2

  - type: comment
    text: "Clean output. That's the fix."
    pause_after: 2
</file>

